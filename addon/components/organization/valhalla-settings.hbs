{{#if this.isActive}}
    <ContentPanel @title="Configure Valhalla" @open={{true}} @wrapperClass="bordered-classic">
        <InputGroup @name="Organization Override">
            <Checkbox @value={{this.useOwnServer}} @label="Use my own Valhalla server" @onToggle={{fn (mut this.useOwnServer)}} @alignItems="center" @labelClass="mb-0i" />
        </InputGroup>

        {{#if this.useOwnServer}}
            <InputGroup @name="Valhalla API Host" @helpText="Organization-specific Valhalla host override.">
                <Input @value={{this.apiHost}} placeholder="https://your-valhalla-host.example.com" class="w-full form-input" />
            </InputGroup>
            <InputGroup
                @name="Valhalla API Key"
                @helpText={{if this.hasApiKey "An organization API key is saved. It is never shown; leave this blank to keep it." "Optional organization-specific API key override."}}
            >
                <Input
                    @type="password"
                    @value={{this.apiKey}}
                    placeholder={{if this.hasApiKey "Saved key hidden. Enter a new key to replace it" "Enter organization Valhalla API key"}}
                    autocomplete="new-password"
                    disabled={{this.clearApiKey}}
                    class="w-full form-input"
                />
            </InputGroup>
            {{#if this.hasApiKey}}
                <InputGroup>
                    <Checkbox @value={{this.clearApiKey}} @label="Remove the saved API key" @onToggle={{fn (mut this.clearApiKey)}} @alignItems="center" @labelClass="mb-0i" />
                </InputGroup>
            {{/if}}
        {{/if}}
    </ContentPanel>
{{/if}}
